{
  "manifest_version": 3,
  "name": "Browser-Locker",
  "version": "1.1.0",
  "description": "Native OS-grade browser lock with window-close auto-lock, zero-second grace period, and strict single-tab enforcement.",
  "author": "GOLAM MONAYEM",
  "minimum_chrome_version": "102",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Browser-Locker",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "permissions": [
    "storage",
    "tabs",
    "idle",
    "alarms"
  ],
  "commands": {
    "lock-browser": {
      "suggested_key": {
        "default": "Alt+Shift+L",
        "mac": "Alt+Shift+L"
      },
      "description": "Instantly lock the browser"
    }
  }
}
