{
  "manifest_version": 3,
  "name": "Browser-Locker",
  "version": "1.0.0",
  "description": "Production-ready browser locker with master password, idle auto-lock, grace period, and offline recovery key.",
  "permissions": [
    "storage",
    "tabs",
    "idle",
    "alarms"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Browser-Locker",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "commands": {
    "lock-browser": {
      "suggested_key": {
        "default": "Alt+Shift+L"
      },
      "description": "Lock the browser immediately"
    }
  }
}
